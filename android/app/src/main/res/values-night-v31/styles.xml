<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and newer draw their own splash before the app starts, and it cannot be switched off. Here it is
         plain white with no icon, so the animation drawn by the app (lib/view/splash) fades the icon in on the same
         white and nothing jumps between the two. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
