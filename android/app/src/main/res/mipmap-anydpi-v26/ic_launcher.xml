<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon on Android 8 and later: a landscape photo filling the whole icon (background) with lf carved
     into it (foreground), shaped by the launcher. The monochrome layer is what Android 13 and later draw when
     themed icons are on. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
