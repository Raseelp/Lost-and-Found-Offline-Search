<?xml version="1.0" encoding="utf-8"?>
<!-- The opened daily memory: the postcard, then what kind it is and its words. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/memory_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:maxHeight="168dp"
        android:paddingBottom="8dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/memory_eyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:textColor="#2FA89E"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/memory_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2" />

    <TextView
        android:id="@+id/memory_body"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2" />
</LinearLayout>
