<?xml version="1.0" encoding="utf-8"?>
<!-- The scan, folded: what is happening now on one line, and its bar: indexing's two-part bar (photos, then
     videos, each as long as its share) or the violet bar of finding faces. See ScanNotification. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/lane_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/lane_dot_photos" />

        <TextView
            android:id="@+id/lane_title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/lane_count"
            style="@style/TextAppearance.Compat.Notification.Line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Indexing's bar, photos then videos, drawn by ScanNotification.splitBar (each part as long as its share). -->
    <ImageView
        android:id="@+id/lane_split"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <ProgressBar
        android:id="@+id/lane_bar_faces"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progressDrawable="@drawable/lane_bar_faces"
        android:visibility="gone" />
</LinearLayout>
